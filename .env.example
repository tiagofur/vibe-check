# Ruta de la base de datos SQLite (historial de auditorías).
# La ruta es relativa a prisma/schema.prisma; ../db apunta a <repo>/db/custom.db
DATABASE_URL=file:../db/custom.db

# ── IA: trae tu propia key (OPCIONAL — elige UN proveedor) ────────
# Sin ninguna de estas, VibeCheck corre en modo determinista
# (grafo de imports + escaneo, cero LLM).
#
# Gemini / Google AI Studio — generoso free tier, flash es barato
# GEMINI_API_KEY=""
# OpenRouter — una sola key, cientos de modelos (GLM, Gemini, Claude, GPT…)
# OPENROUTER_API_KEY=""
# OpenAI — los "mini" son el tier económico
# OPENAI_API_KEY=""
# Anthropic — Haiku es el económico
# ANTHROPIC_API_KEY=""
# Z.ai directo (GLM) — el mismo modelo del SDK original
# ZAI_API_KEY=""
# Ollama local (sin key; el código nunca sale de la máquina)
# OLLAMA_MODEL="qwen2.5-coder:7b"
# OLLAMA_BASE_URL="http://localhost:11434"

# ── Opcionales ────────────────────────────────────────────────────
# Forzar proveedor (gemini|openai|anthropic|openrouter|zai|ollama|none)
# y/o modelo concreto (si no, cada provider usa su default barato):
# LLM_PROVIDER=
# LLM_MODEL=
# Endpoint alternativo (proxies, gateways, Azure…):
# LLM_BASE_URL=

# Token de GitHub para repos privados (opcional; la Action de PR usa GITHUB_TOKEN)
# GITHUB_TOKEN=
